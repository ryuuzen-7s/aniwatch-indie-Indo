# ─── SOURCE ───
OTAKUDESU_URL=https://otakudesu.blog

# ─── BEHAVIOR ───
FOLLOW_ALL_EPISODES=false
SKIP_EXISTING=true
DELAY_BETWEEN=5.0              # Jeda antar anime (hemat CPU)

# ─── AUTO ONGOING ───
SCRAPE_ONGOING=true
ONGOING_LIMIT=10               # ← Kurangi dari 20 ke 10

# ─── SCHEDULE ───
INTERVAL_HOURS=12              # ← Task Scheduler 12 jam
CRON_TIME=03:00
TIMEZONE=Asia/Jakarta

# ─── MODE (BARU v1.1.0) ───
MODE=hybrid
CALLER_PRIORITY=true
WATCHER_INTERVAL=60            # Cek queue tiap 60 detik

# ─── LOGGING ───
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=agent.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# ─── DB ───
DB_PATH=../data/db/aniwatch.db

# ─── SLUGS (Follow .env) ───
SLUG_1=yowaki-max-sub-indo
SLUG_2=one-piece-sub-indo
SLUG_3=naruto-sub-indo
SLUG_4=jujutsu-kaisen-sub-indo